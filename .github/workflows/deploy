name: Deploy to Shared Hosting (Ed25519)

on:
  push:
    branches:
      - main

jobs:
  deploy:
    runs-on: ubuntu-latest
    steps:
      - name: Checkout code
        uses: actions/checkout@v4

      - name: Deploy via rsync
        env:
          SSH_PRIVATE_KEY: ${{ secrets.SSH_PRIVATE_KEY }}
          SSH_HOST: ${{ secrets.SSH_HOST }}
          SSH_USER: ${{ secrets.SSH_USER }}
          SSH_PORT: ${{ secrets.SSH_PORT || '22' }} 
          TARGET_DIR: ${{ secrets.TARGET_DIR }}
        run: |
          # 1. Setup .ssh directory
          mkdir -p ~/.ssh
          chmod 700 ~/.ssh
          
          # 2. Save the Private Key to a file
          # We name it id_ed25519 for clarity
          echo "$SSH_PRIVATE_KEY" > ~/.ssh/id_ed25519
          chmod 600 ~/.ssh/id_ed25519
          
          # 3. Add Server to Known Hosts
          # This prevents the "Host key verification failed" error
          ssh-keyscan -p $SSH_PORT $SSH_HOST >> ~/.ssh/known_hosts
          
          # 4. Sync files
          # -i specifies the identity file we just created
          rsync -avz --delete -e "ssh -p $SSH_PORT -i ~/.ssh/id_ed25519" \
            --exclude '.git' \
            --exclude '.github' \
            --exclude '.env' \
            ./ $SSH_USER@$SSH_HOST:$TARGET_DIR