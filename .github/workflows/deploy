name: Deploy Multi-Env with Config (Ed25519)

on:
  push:
    branches:
      - main
      - staging

jobs:
  deploy:
    runs-on: ubuntu-latest
    steps:
      - name: Checkout code
        uses: actions/checkout@v4

      # --- NEW STEP: Generate the correct .env file ---
      - name: Create .env file
        run: |
          if [[ "${{ github.ref }}" == "refs/heads/main" ]]; then
            # echo "Generating PRODUCTION .env"
            # We dump the secret content directly into a file named .env
           # echo "${{ secrets.ENV_PROD }}" > .env
            
            # Set deployment destination for Main
            echo "DEPLOY_DEST=${{ secrets.TARGET_DIR }}" >> $GITHUB_ENV
            
          elif [[ "${{ github.ref }}" == "refs/heads/staging" ]]; then
            echo "Generating STAGING .env"
            echo "${{ secrets.ENV_STAGING }}" > .env
            
            # Set deployment destination for Staging
            echo "DEPLOY_DEST=${{ secrets.TARGET_STAGE_DIR }}" >> $GITHUB_ENV
          fi

      - name: Deploy via rsync
        env:
          SSH_PRIVATE_KEY: ${{ secrets.SSH_PRIVATE_KEY }}
          SSH_HOST: ${{ secrets.SSH_HOST }}
          SSH_USER: ${{ secrets.SSH_USER }}
          SSH_PORT: ${{ secrets.SSH_PORT || '22' }} 
        run: |
          mkdir -p ~/.ssh
          chmod 700 ~/.ssh
          echo "$SSH_PRIVATE_KEY" > ~/.ssh/id_ed25519
          chmod 600 ~/.ssh/id_ed25519
          ssh-keyscan -p $SSH_PORT $SSH_HOST >> ~/.ssh/known_hosts
          
          # IMPORTANT: We REMOVED "--exclude '.env'" from below
          # This ensures the new .env file we just created gets uploaded.
          rsync -avz --delete -e "ssh -p $SSH_PORT -i ~/.ssh/id_ed25519" \
            --exclude '.git' \
            --exclude '.github' \
            ./ $SSH_USER@$SSH_HOST:$DEPLOY_DEST